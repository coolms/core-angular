{
    "name": "@coolms/core-angular",
    "version": "0.1.0",
    "private": true,
    "description": "The CoolMS client runtime for Angular: session and token refresh, boot manifest and app configuration, theme, user preferences, error handling, HTTP interceptors, and the wire types the CoolMS API emits.",
    "license": "MIT",
    "author": {
        "name": "Dmitry Popov",
        "email": "d.popov@coolms.com"
    },
    "type": "module",
    "peerDependencies": {
        "@angular/common": "^19.0.0",
        "@angular/core": "^19.0.0",
        "@angular/forms": "^19.0.0",
        "@angular/router": "^19.0.0",
        "@ngxs/store": "^19.0.0",
        "rxjs": "^7.8.0"
    },
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "coolms",
        "angular",
        "cms",
        "client",
        "runtime"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/coolms/core-angular.git"
    },
    "scripts": {
        "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
        "typecheck": "tsc -p tsconfig.lib.json --noEmit",
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
    },
    "devDependencies": {
        "@angular/common": "^19.0.0",
        "@angular/compiler": "^19.0.0",
        "@angular/compiler-cli": "^19.0.0",
        "@angular/core": "^19.0.0",
        "@angular/forms": "^19.0.0",
        "@angular/router": "^19.0.0",
        "@ngxs/store": "^19.0.0",
        "ng-packagr": "^19.2.2",
        "rxjs": "^7.8.0",
        "tslib": "^2.3.0",
        "typescript": "^5.5.0"
    }
}
